# کپی کنید به .env (در .gitignore است) و رمز را پر کنید
SERVER_PORT=8085

DB_NAME=s5_settlement_db
DB_USERNAME=labbank_s5
DB_PASSWORD=change_me
# وقتی سرویس را با mvn روی سیستم خودتان اجرا می‌کنید:
DB_URL=jdbc:postgresql://localhost:5432/s5_settlement_db

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# اختیاری: تنظیمات شبیه‌ساز RTGS
RTGS_LATENCY_MS=200
RTGS_TRANSIENT_RATE=0.05
RTGS_FAILURE_RATE=0.05
